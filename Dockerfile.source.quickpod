ARG BASE_IMAGE=ghcr.io/ggml-org/llama.cpp
ARG BASE_TAG=server-cuda

FROM node:22-bookworm-slim AS ui-builder

WORKDIR /src/ui-svelte

COPY ui-svelte/package.json ui-svelte/package-lock.json ./
RUN npm ci

RUN mkdir -p /src/proxy
COPY ui-svelte/ ./
RUN npm run build


FROM golang:1.25.4-bookworm AS go-builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=ui-builder /src/proxy/ui_dist ./proxy/ui_dist

ARG BUILD_DATE=unknown
ARG GIT_COMMIT=source
ARG VERSION=source

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build \
    -ldflags="-X main.commit=${GIT_COMMIT} -X main.version=${VERSION} -X main.date=${BUILD_DATE}" \
    -o /out/llama-swap .


FROM ${BASE_IMAGE}:${BASE_TAG}

ARG UID=10001
ARG GID=10001
ARG USER_HOME=/app

ENV HOME=$USER_HOME
RUN if [ $UID -ne 0 ]; then \
      if [ $GID -ne 0 ]; then \
        groupadd --system --gid $GID app; \
      fi; \
      useradd --system --uid $UID --gid $GID \
      --home $USER_HOME app; \
    fi

RUN mkdir --parents $HOME /app
RUN chown --recursive $UID:$GID $HOME /app

USER $UID:$GID

WORKDIR /app

ENV PATH="/app:${PATH}"

COPY --from=go-builder --chown=$UID:$GID /out/llama-swap /app/llama-swap
COPY --chmod=755 --chown=$UID:$GID docker/quickpod-entrypoint.sh /app/quickpod-entrypoint
COPY --chmod=755 --chown=$UID:$GID docker/llama-server-progress.sh /app/llama-server-progress
COPY --chown=$UID:$GID quickpod.config.yaml /app/config.yaml
COPY --chown=$UID:$GID think.gbnf /app/think.gbnf

HEALTHCHECK CMD curl -f http://localhost:8080/ || exit 1
ENTRYPOINT [ "/app/quickpod-entrypoint" ]
